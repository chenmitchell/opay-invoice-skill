# =============================================================================
# .gitattributes
#
# 兩個目的：
#   1. 換行一律 LF，避免 Windows 使用者 clone 之後整個檔案變成 CRLF 的假 diff，
#      也避免 shell 腳本因為 CRLF 在 Linux 上直接跑不起來。
#   2. 用 linguist-* 讓 GitHub 的語言統計與 diff 呈現正確。
# =============================================================================

# 預設：由 git 自動判斷文字檔，並在 repo 內一律存成 LF
* text=auto eol=lf

# ---- 明確指定為文字（含中文內容，避免被誤判為 binary） ----------------------
*.md        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.php       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.cff       text eol=lf
*.example   text eol=lf
.gitignore      text eol=lf
.editorconfig   text eol=lf
.gitattributes  text eol=lf
LICENSE         text eol=lf

# Shell 腳本：**絕對**不能是 CRLF，否則在 Linux 上會出現
# "bad interpreter: /usr/bin/env bash^M" 這種難查的錯誤
*.sh        text eol=lf

# ---- 二進位檔 ---------------------------------------------------------------
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.docx      binary
*.xlsx      binary

# ---- GitHub 語言統計 --------------------------------------------------------
# templates/ 是給使用者複製的範本，不是本 repo 的「主要語言」，
# 但仍希望它們被語法標色，所以只標 documentation 不標 vendored。
templates/**       linguist-documentation
test-vectors/**    linguist-documentation

# guides/ 與 references/ 是本 repo 的主體
guides/**          linguist-documentation=false
references/**      linguist-documentation=false

# SSOT：diff 時給它一個清楚的 hunk 標頭
references/api-coverage.json  diff=json

# ---- 打包時不需要的檔案（git archive / GitHub 下載 ZIP 會排除） -------------
.github/        export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
.editorconfig   export-ignore
