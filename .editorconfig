# =============================================================================
# .editorconfig
#
# 統一縮排與換行，避免「整個檔案都是 diff」這種假變更蓋掉真正的修改。
# 說明文件：https://editorconfig.org
# =============================================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

# Markdown：行尾兩個空白是「換行」語法，不能 trim
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Python：PEP 8
[*.py]
indent_size = 4
max_line_length = 99

# PHP：PSR-12
[*.php]
indent_size = 4
max_line_length = 120

# JavaScript
[*.{js,mjs,cjs,ts}]
indent_size = 2

# Shell：檢查腳本
[*.sh]
indent_size = 2

# JSON / YAML
[*.{json,yml,yaml}]
indent_size = 2

# api-coverage.json 是 SSOT，每筆 endpoint 刻意寫成單行以便 diff 一眼看出增減
[references/api-coverage.json]
max_line_length = off

# Makefile 必須用 tab
[Makefile]
indent_style = tab

# .env 範本
[.env*]
indent_style = space
indent_size = 2
