# ---------------------------------------------------------------------------
# discord-bot 環境變數範本
# 用途：歐付寶電子發票 Discord 通知／查詢機器人（bot.py）
# 對應：references/b2c-api-reference.md（GetIssue / GetInvoiceWordSetting / Invalid / Allowance）
# 使用：cp .env.example .env 後填寫；.env 必須加入 .gitignore，嚴禁 commit
# ---------------------------------------------------------------------------

# Discord 機器人 token。Developer Portal → 你的應用程式 → Bot → Reset Token 取得（通常 59 碼以上）。
# 注意不要誤填 Application ID 或 Public Key。缺這一項機器人會以中文訊息結束，不會啟動。
DISCORD_BOT_TOKEN=

# 另外必做：Developer Portal → Bot → Privileged Gateway Intents → 開啟「MESSAGE CONTENT INTENT」，
# 否則機器人收得到訊息但讀不到內容，所有指令都不會有反應。

# 綁定頻道用的管理密碼，同事以 !bind <ADMIN_TOKEN> 綁定。
# 建議用 `openssl rand -hex 16` 產生，至少 12 碼；請勿在公開頻道貼出。
ADMIN_TOKEN=

# 指令前綴。預設 !；若與其他機器人衝突可改成例如 opay! 之類。
COMMAND_PREFIX=!

# 商店系統呼叫 /notify 時要帶的 X-Notify-Token（留空代表不驗證，僅限本機測試）。
NOTIFY_TOKEN=

# 事件接收埠（只綁 127.0.0.1）。商店系統開立發票後 POST 事件到 http://127.0.0.1:<PORT>/notify
# 事件格式：{"event":"issue_success|issue_failed|invalid|allowance|word_low", ...}
NOTIFY_PORT=8791

# 本機狀態資料庫（綁定的頻道、事件、稽核紀錄、待確認動作）。
BOT_DB_PATH=./bot-state.sqlite3

# 稽核 log 檔路徑。作廢與折讓等不可逆操作都會寫在這裡，請納入備份與保存政策。
AUDIT_LOG_PATH=./audit.log

# ---- 歐付寶電子發票 API 參數（查詢／作廢／折讓會用到） --------------------
# 特店編號。測試環境 B2C 為 2000132；正式環境請至廠商後台查詢。
OPAY_MERCHANT_ID=2000132

# AES-128 金鑰與 IV（各 16 碼）。以下為官方公開的「僅測試環境」值。
# ⚠️ 正式環境金鑰只能放在這個 .env 或 Secret Manager，絕不可寫進程式碼。
OPAY_HASH_KEY=ejCk326UnaZWKisg
OPAY_HASH_IV=q9jcZX8Ib9LM8wYk

# API host。測試 https://einvoice-stage.opay.tw；正式 https://einvoice.opay.tw
OPAY_HOST=https://einvoice-stage.opay.tw

# ---- 營運參數 --------------------------------------------------------------
# 字軌剩餘數量警戒值（張）。低於此值且字軌為「使用中」時會推播警示。
# 電子發票號碼用完會直接開不出發票，建議抓至少「尖峰時段兩天的開立量」。
WORD_REMAIN_THRESHOLD=200

# 字軌檢查間隔（秒），最小 60。預設每小時檢查一次。
WORD_CHECK_INTERVAL=3600

# 大額提醒門檻（元）。作廢／折讓金額達此值只會「加註警示」，不會阻擋操作。
LARGE_AMOUNT_WARN=50000

# 二次確認驗證碼有效秒數。
CONFIRM_TTL_SECONDS=300
