# ---------------------------------------------------------------------------
# opay-test-console 環境變數範本
# 用途：測試環境全鏈路儀表板（backend.py + console.html）的設定來源
# 對應：references/b2c-api-reference.md「共通事項 / 測試環境參數」
# 使用：cp .env.example .env 後修改，.env 一定要加進 .gitignore，嚴禁 commit
# ---------------------------------------------------------------------------

# 特店編號。測試環境 B2C 用 2000132；離線發票測試特店為 2045501。
# 正式環境請至歐付寶廠商後台查詢，並且與下方金鑰必須是同一組，混用會直接 TransCode 失敗。
OPAY_MERCHANT_ID=2000132

# AES-128 金鑰（16 碼）。以下為官方文件公開的「僅測試環境」值。
# ⚠️ 正式環境金鑰只能放在這個 .env（或 Secret Manager），絕對不可寫進程式碼或 commit。
OPAY_HASH_KEY=ejCk326UnaZWKisg

# AES-128 IV（16 碼）。同樣僅測試環境可用此公開值。
OPAY_HASH_IV=q9jcZX8Ib9LM8wYk

# API host。測試環境 https://einvoice-stage.opay.tw；正式環境 https://einvoice.opay.tw。
# 本主控台設計給測試環境使用；指向正式環境時，開立示範會被後端擋下。
OPAY_HOST=https://einvoice-stage.opay.tw

# 特約合作平台商代號。一般廠商留空；平台商才填（測試環境平台商為 2046611）。
OPAY_PLATFORM_ID=

# 是否允許「開立測試發票」按鈕實際送出。
# 預設 false。設成 true 之前請理解：這會在測試環境產生真實發票紀錄、消耗字軌號碼，且只能作廢無法刪除。
OPAY_ALLOW_ISSUE_DEMO=false

# 本機服務埠號（直接 python3 backend.py 啟動時生效）。
PORT=8080
